# ===============================================
# Aurora Innovative Learning Platform
# Environment Variables Configuration
# ===============================================
# This file contains all environment variables needed for the application
# Copy this to .env.local for local development
# For production, set these in your hosting platform's environment settings

# ===============================================
# 🌐 APPWRITE CONFIGURATION
# ===============================================
# Backend as a Service (BaaS) configuration for authentication, database, and storage
# Get these values from your Appwrite Console: https://cloud.appwrite.io

# Appwrite Cloud Endpoint - Use the region closest to your users
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Your unique project ID from Appwrite Console
NEXT_PUBLIC_APPWRITE_PROJECT_ID=YOUR_APPWRITE_PROJECT_ID_HERE

# ===============================================
# 🗄️ APPWRITE DATABASE CONFIGURATION
# ===============================================
# Database IDs for organizing different types of data

# Main database for core application data
NEXT_PUBLIC_APPWRITE_DATABASE_MAIN_ID=aurora_main

# Analytics database for tracking user behavior and course performance
NEXT_PUBLIC_APPWRITE_DATABASE_ANALYTICS_ID=aurora_analytics

# Content database for storing course materials and metadata
NEXT_PUBLIC_APPWRITE_DATABASE_CONTENT_ID=aurora_content

# ===============================================
# 📊 APPWRITE COLLECTION IDS
# ===============================================
# Collection IDs for different data entities in the main database

# User profiles and authentication data
NEXT_PUBLIC_APPWRITE_COLLECTION_USERS_ID=users

# Course information and metadata
NEXT_PUBLIC_APPWRITE_COLLECTION_COURSES_ID=courses

# Individual lessons within courses
NEXT_PUBLIC_APPWRITE_COLLECTION_LESSONS_ID=lessons

# Student enrollments and progress tracking
NEXT_PUBLIC_APPWRITE_COLLECTION_ENROLLMENTS_ID=enrollments

# Secure video access tokens for protected content
NEXT_PUBLIC_APPWRITE_COLLECTION_VIDEO_TOKENS_ID=video_access_tokens

# User activity logs and analytics
NEXT_PUBLIC_APPWRITE_COLLECTION_USER_ACTIVITY_ID=user_activity

# Course performance analytics
NEXT_PUBLIC_APPWRITE_COLLECTION_COURSE_ANALYTICS_ID=course_analytics

# File upload metadata and information
NEXT_PUBLIC_APPWRITE_COLLECTION_FILE_METADATA_ID=file_metadata

# Payment method configurations (bKash, Nagad, etc.)
NEXT_PUBLIC_APPWRITE_COLLECTION_PAYMENT_METHODS_ID=payment_methods

# Student payment requests and verification status
NEXT_PUBLIC_APPWRITE_COLLECTION_PAYMENT_REQUESTS_ID=payment_requests

# ===============================================
# 📁 APPWRITE STORAGE BUCKETS
# ===============================================
# Storage bucket IDs for file organization

# Course materials (PDFs, documents, resources)
NEXT_PUBLIC_APPWRITE_BUCKET_COURSE_MATERIALS_ID=course-materials

# User uploads (profile pictures, assignments)
NEXT_PUBLIC_APPWRITE_BUCKET_USER_UPLOADS_ID=user-uploads

# Course thumbnails and images
NEXT_PUBLIC_APPWRITE_BUCKET_THUMBNAILS_ID=thumbnails

# Generated course completion certificates
NEXT_PUBLIC_APPWRITE_BUCKET_CERTIFICATES_ID=certificates

# ===============================================
# ⚡ APPWRITE CLOUD FUNCTIONS
# ===============================================
# Serverless function IDs for backend processing

# Handle course enrollment logic
NEXT_PUBLIC_APPWRITE_FUNCTION_ENROLLMENT_ID=enrollment-handler

# YouTube video integration and validation
NEXT_PUBLIC_APPWRITE_FUNCTION_YOUTUBE_ID=youtube-integration

# Email and push notification system
NEXT_PUBLIC_APPWRITE_FUNCTION_NOTIFICATIONS_ID=notification-system

# Video progress tracking and analytics
NEXT_PUBLIC_APPWRITE_FUNCTION_VIDEO_PROGRESS_ID=video-progress

# Security monitoring and threat detection
NEXT_PUBLIC_APPWRITE_FUNCTION_SECURITY_ID=security-monitoring

# Secure video access token generation
NEXT_PUBLIC_APPWRITE_FUNCTION_VIDEO_ACCESS_ID=video-access-token

# Secure video embedding and DRM
NEXT_PUBLIC_APPWRITE_FUNCTION_SECURE_EMBED_ID=secure-video-embed

# ===============================================
# 🔐 AUTHENTICATION & SECURITY
# ===============================================
# Authentication and security configuration

# JWT secret for token signing (generate a random 256-bit key)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Session timeout in seconds (default: 7 days)
SESSION_TIMEOUT=604800

# Password reset token expiration (in minutes)
PASSWORD_RESET_TIMEOUT=60

# Maximum login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes
LOCKOUT_DURATION=30

# ===============================================
# 💳 PAYMENT GATEWAY CONFIGURATION
# ===============================================
# bKash and Nagad payment integration settings

# bKash Payment Gateway
BKASH_MERCHANT_ID=your_bkash_merchant_id
BKASH_MERCHANT_SECRET=your_bkash_merchant_secret
BKASH_SANDBOX_MODE=true
BKASH_API_ENDPOINT=https://tokenized.pay.bka.sh/v1.2.0-beta

# Nagad Payment Gateway
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_SECRET=your_nagad_merchant_secret
NAGAD_SANDBOX_MODE=true
NAGAD_API_ENDPOINT=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0

# Payment webhook verification key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_key

# Default payment expiration time (in hours)
PAYMENT_EXPIRY_HOURS=48

# ===============================================
# 📺 VIDEO STREAMING CONFIGURATION
# ===============================================
# Video hosting and streaming settings

# YouTube API key for video validation and metadata
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Drive API credentials for Drive video integration
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret

# Video access token expiration (in seconds)
VIDEO_TOKEN_EXPIRY=3600

# Maximum video resolution allowed
MAX_VIDEO_RESOLUTION=1080p

# Video streaming CDN URL (if using external CDN)
VIDEO_CDN_URL=https://your-video-cdn.com

# ===============================================
# 📧 EMAIL CONFIGURATION
# ===============================================
# Email service settings for notifications and communications

# SMTP Configuration (for transactional emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email templates and branding
EMAIL_FROM_NAME=Aurora Learning Platform
EMAIL_FROM_ADDRESS=noreply@auroralearning.com

# SendGrid API (alternative email service)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Email service provider selection (smtp|sendgrid)
EMAIL_PROVIDER=smtp

# ===============================================
# 🔧 APPLICATION CONFIGURATION
# ===============================================
# General application settings

# Application environment
NODE_ENV=development

# Application URL (used for redirects and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application name and branding
NEXT_PUBLIC_APP_NAME=Aurora Innovative Learning

# Company information
NEXT_PUBLIC_COMPANY_NAME=Aurora Learning Platform
NEXT_PUBLIC_COMPANY_EMAIL=info@auroralearning.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@auroralearning.com

# ===============================================
# 🚀 PERFORMANCE & OPTIMIZATION
# ===============================================
# Performance and optimization settings

# Enable/disable analytics tracking
ENABLE_ANALYTICS=true

# Google Analytics tracking ID
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Image optimization settings
ENABLE_IMAGE_OPTIMIZATION=true
IMAGE_QUALITY=75

# Cache settings (in seconds)
STATIC_CACHE_DURATION=86400
API_CACHE_DURATION=300

# ===============================================
# 📊 MONITORING & LOGGING
# ===============================================
# Application monitoring and error tracking

# Enable detailed logging
ENABLE_DEBUG_LOGGING=true

# Log level (error|warn|info|debug)
LOG_LEVEL=debug

# Sentry error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here

# Error reporting webhook URL
ERROR_WEBHOOK_URL=https://your-monitoring-service.com/webhook

# ===============================================
# 🔍 SEO & SOCIAL MEDIA
# ===============================================
# SEO and social media integration

# Open Graph and social media metadata
NEXT_PUBLIC_OG_TITLE=Aurora Innovative Learning Platform
NEXT_PUBLIC_OG_DESCRIPTION=Learn cutting-edge technologies with expert instructors
NEXT_PUBLIC_OG_IMAGE=https://yourdomain.com/og-image.jpg

# Social media links
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/auroralearning
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/auroralearning
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/auroralearning

# ===============================================
# 🌍 INTERNATIONALIZATION
# ===============================================
# Language and localization settings

# Default language
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supported languages (comma-separated)
NEXT_PUBLIC_SUPPORTED_LOCALES=en,bn

# Currency settings
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_CURRENCY_SYMBOL=৳

# ===============================================
# 📱 MOBILE APP CONFIGURATION
# ===============================================
# Mobile app deep linking and PWA settings

# Deep link scheme for mobile app
MOBILE_APP_SCHEME=auroralearning

# PWA settings
ENABLE_PWA=true
PWA_NAME=Aurora Learning
PWA_SHORT_NAME=Aurora

# ===============================================
# 🔄 BACKUP & RECOVERY
# ===============================================
# Backup and disaster recovery settings

# Database backup frequency (in hours)
BACKUP_FREQUENCY=24

# Backup retention period (in days)
BACKUP_RETENTION=30

# Backup storage location
BACKUP_STORAGE_BUCKET=aurora-backups

# ===============================================
# 🎯 FEATURE FLAGS
# ===============================================
# Feature toggles for gradual rollouts

# Enable/disable specific features
FEATURE_PAYMENT_GATEWAY=true
FEATURE_VIDEO_STREAMING=true
FEATURE_CERTIFICATES=true
FEATURE_ANALYTICS=true
FEATURE_NOTIFICATIONS=true
FEATURE_SOCIAL_LOGIN=false

# Beta features
FEATURE_AI_RECOMMENDATIONS=false
FEATURE_LIVE_CLASSES=false

# ===============================================
# 📋 IMPORTANT SETUP NOTES
# ===============================================
# 
# 1. REQUIRED SETUP:
#    - Replace ALL placeholder values with actual credentials
#    - Create Appwrite project and get Project ID
#    - Set up all collections and buckets in Appwrite
#    - Configure payment gateway accounts
#    - Set up email service credentials
#
# 2. SECURITY:
#    - Use strong, unique passwords and API keys
#    - Never commit this file to version control with real credentials
#    - Use different credentials for development and production
#    - Regularly rotate API keys and secrets
#
# 3. PRODUCTION DEPLOYMENT:
#    - Create .env.local for local development
#    - Set environment variables in your hosting platform
#    - Update NEXT_PUBLIC_APP_URL to your domain
#    - Enable HTTPS in production
#    - Set NODE_ENV=production
#
# 4. DOCUMENTATION:
#    - See README-APPWRITE-SETUP.md for Appwrite configuration
#    - See PAYMENT-COLLECTIONS-SETUP.md for payment setup
#    - Check package.json for all dependencies
#
# ===============================================